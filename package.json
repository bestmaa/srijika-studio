{
  "name": "srijika-studio-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @srijika/studio dev",
    "dev:host": "pnpm --filter @srijika/studio dev --host 0.0.0.0",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contracts": "vitest run --project contracts",
    "test:coverage": "vitest run --coverage",
    "test:e2e:web": "playwright test",
    "test:e2e:desktop": "node tests/e2e/tauri-desktop-smoke.mjs",
    "test:e2e:desktop:code-first": "node tests/e2e/tauri-code-first-shared-smoke.mjs",
    "test:visual": "playwright test --grep @visual",
    "test:a11y": "playwright test --grep @a11y",
    "test:mcp": "vitest run --project unit tests/unit/automation-protocol.unit.test.ts tests/unit/mcp-bridge-client.unit.test.ts tests/unit/mcp-server.unit.test.ts",
    "test:mcp:stdio": "node tests/e2e/mcp-stdio-smoke.mjs",
    "test:mcp:isolated": "node tests/e2e/mcp-stdio-smoke.mjs --isolated",
    "test:mcp:code": "node tests/e2e/mcp-code-project-smoke.mjs",
    "test:mcp:tauri": "node tests/e2e/mcp-tauri-live-smoke.mjs",
    "test:mcp:tauri:orbit": "node tests/e2e/mcp-tauri-orbit-fidelity.mjs",
    "test:mcp:windows": "node tests/e2e/mcp-stdio-smoke.mjs --windows",
    "plugin:build": "pnpm --filter @srijika/mcp-server build",
    "cli:build": "pnpm --filter @srijika/cli build",
    "release:version": "node scripts/set-npm-release-version.mjs",
    "release:build": "pnpm --filter @srijika/cli build && pnpm --filter @srijika/mcp-server build",
    "release:verify": "node scripts/verify-npm-release.mjs",
    "release:publish": "node scripts/publish-npm-packages.mjs",
    "srijika": "node packages/cli/dist/cli.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "tauri": "pnpm --filter @srijika/studio tauri"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@eslint/js": "10.0.1",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
