    "typecheck": "node scripts/sync-docs.mjs && astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "typescript": "6.0.3"
  }
}
