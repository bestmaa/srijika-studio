{
  "name": "@srijika/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev --host 0.0.0.0",
