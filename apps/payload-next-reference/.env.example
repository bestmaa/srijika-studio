# Local development only. Production Compose reads both secrets from mounted files.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/srijika_payload
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Docker Compose host settings. Copy this file to .env, then create the two ignored
# secret files with random values before starting the reference deployment.
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password.txt
PAYLOAD_SECRET_FILE=./deploy/secrets/payload_secret.txt
PAYLOAD_WEB_BIND=127.0.0.1
PAYLOAD_WEB_PORT=3000

# PAYLOAD_REFERENCE_MODE=mock is reserved for deterministic build and browser evidence.
