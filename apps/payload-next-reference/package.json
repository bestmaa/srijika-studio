{
  "name": "@srijika/payload-next-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:compose": "node test/compose-reference.test.mjs",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "payload:migration": "payload migrate:create",
    "payload:migrate": "payload migrate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "graphql": "16.12.0",
    "next": "16.3.3",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@srijika/tsx-compiler": "workspace:*",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
