{
  "name": "@srijika/cli",
  "version": "0.2.0",
  "description": "Fast, ownership-aware Srijika project CLI with Vite HMR and optional Bun turbo mode.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/cli.mjs"
  },
  "bin": {
    "srijika": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bestmaa/srijika-studio.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bestmaa/srijika-studio#readme",
  "bugs": "https://github.com/bestmaa/srijika-studio/issues",
  "dependencies": {
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@srijika/architecture-rules": "workspace:*",
    "@srijika/developer-engine": "workspace:*",
    "@srijika/project-scaffold": "workspace:*",
    "@types/node": "26.1.2",
    "esbuild": "0.25.12",
    "vitest": "4.1.10"
  }
}
