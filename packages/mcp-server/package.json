{
  "name": "@srijika/mcp-server",
  "version": "0.1.0",
  "description": "CLI-first Srijika project MCP tools with optional Studio bridge support.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "bin": {
    "srijika-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@srijika/architecture-rules": "workspace:*",
    "@srijika/automation-protocol": "workspace:*",
    "@srijika/developer-engine": "workspace:*",
    "@srijika/project-scaffold": "workspace:*",
    "esbuild": "0.25.12"
  }
}
